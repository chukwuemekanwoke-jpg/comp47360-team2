# Copy to .env and adjust:
#   cp .env.example .env
#
# Start Postgres:  npm run db:up   (uses docker-compose.yml)
# Apply schema:    npm run migrate

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/table_dev

# Optional: host port if 5432 is already in use (must match docker-compose port mapping)
# POSTGRES_PORT=5433
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/table_dev
