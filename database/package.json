{
  "name": "table-database",
  "version": "1.0.0",
  "private": true,
  "description": "Tablé PostgreSQL migrations (BE-2)",
  "scripts": {
    "db:up": "docker compose -f ../docker-compose.yml up -d postgres",
    "db:down": "docker compose -f ../docker-compose.yml stop postgres",
    "db:logs": "docker compose -f ../docker-compose.yml logs -f postgres",
    "db:reset": "docker compose -f ../docker-compose.yml down -v && docker compose -f ../docker-compose.yml up -d postgres",
    "migrate": "node scripts/migrate.js",
    "migrate:down": "node scripts/migrate.js --down",
    "seed": "node scripts/seed.js",
    "seed:real": "node scripts/seed.js --real",
    "seed:taxi-demand": "node scripts/seed.js --taxi-demand",
    "generate:seed": "node scripts/generate-seed.js",
    "enrich:places": "node scripts/enrich-places.js",
    "db:backup": "bash scripts/backup-local-db.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  }
}
