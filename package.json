{
  "name": "table-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Tablé Monorepo Architecture & Unified DX Integration",
  "workspaces": [
    "database",
    "backend/api-gateway",
    "frontend/web-app",
    "frontend/mobile-app"
  ],
  "scripts": {
    "db:up": "npm run db:up --workspace=table-database",
    "db:down": "npm run db:down --workspace=table-database",
    "db:reset": "npm run db:reset --workspace=table-database",
    "migrate": "npm run migrate --workspace=table-database",
    "seed": "npm run seed --workspace=table-database",
    "dev:backend": "npm run dev --workspace=api-gateway",
    "dev:web": "npm run dev --workspace=table-app",
    "dev:mobile": "npm exec -w frontend/mobile-app -- expo start --tunnel",
    "dev:mobile:clean": "npm exec -w frontend/mobile-app -- expo start -c --tunnel",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
