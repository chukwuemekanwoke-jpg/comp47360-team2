# Copy to .env and adjust for local development:
#   cp .env.example .env

PORT=3001

# PostgreSQL (same as database/.env when using Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/table_dev

# Comma-separated browser origins for CORS (Next.js / Expo dev)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# BE-12: Google Routes API (computeRouteMatrix) for transit-validated ETA.
# Enable "Routes API" on the GCP project. Without a key the gateway falls back
# to a local haversine + fixed-speed estimate.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_ROUTES_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix
ETA_TIMEOUT_MS=3000

# BE-14: FastAPI ML match service (campaign offer targeting)
ML_SERVICE_URL=http://localhost:8000
ML_MATCH_TIMEOUT_MS=5000
