# Copy to .env and adjust for local development:
#   cp .env.example .env

PORT=3001

# PostgreSQL (same as database/.env when using Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/table_dev

# Comma-separated browser origins for CORS (Vite web / Expo dev). Defaults
# already include http://localhost:5173 (Vite) and :8081 (Expo) — only set
# this if you're running on a different port.
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# BE-12: Google Routes API (computeRouteMatrix) for transit-validated ETA.
# Enable "Routes API" on the GCP project. Without a key the gateway falls back
# to a local haversine + fixed-speed estimate.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_ROUTES_URL=https://routes.googleapis.com/distanceMatrix/v2:computeRouteMatrix
ETA_TIMEOUT_MS=3000

# GET /config/maps-key: browser key for the web app's Maps JS/Places location
# picker (RestaurantLocationPicker.jsx). Must be a SEPARATE key from
# GOOGLE_MAPS_API_KEY above, restricted by HTTP referrer to the web app's
# origin(s) — the server-side Routes API key above must stay unrestricted by
# referrer for server-to-server calls, so the two can't safely share one key.
# Without this set, the picker falls back to manual lat/lng entry (404).
# MAPS_JS_API_KEY=

# JWT auth (required in production)
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Local/demo compatibility only. X-User-Id is not a credential, so production
# defaults to false unless this is explicitly overridden. Keep false in every
# deployed environment; use JWT Bearer tokens instead.
# ALLOW_LEGACY_USER_HEADER=false

# Password reset emails (MVP logs link to console; set staging/production web origin)
WEB_APP_URL=http://localhost:5173

# Rate limiting on sensitive routes (auth / booking create / campaign create).
# Enabled by default except NODE_ENV=test. Override with true/false.
# Auth requests are keyed by endpoint + client IP + hashed email/reset token,
# preventing unrelated users behind one shared carrier IP from colliding.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_WRITE_WINDOW_MS=900000
# RATE_LIMIT_WRITE_MAX=60

# BE-14: FastAPI ML match service (campaign offer targeting)
ML_SERVICE_URL=http://localhost:8000
ML_MATCH_TIMEOUT_MS=5000

# Busyness prediction (POST /predict/busyness) — same ML_SERVICE_URL
ML_BUSYNESS_TIMEOUT_MS=5000
