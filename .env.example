# =============================================================================
# Tablé — local Docker stack configuration
# =============================================================================
# Copy this file to .env in the repo root, then run:
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Everything below has a working default, so `docker compose up` runs the full
# stack with zero edits. The API-key section is the only part you need to touch,
# and only to enable the two optional Google Maps features called out there.
#
# .env is gitignored. Never commit real keys.
# -----------------------------------------------------------------------------


# =============================================================================
# 1. API KEYS  ← this is the section you came here for
# =============================================================================
# Both keys below are OPTIONAL. The stack starts and every core user journey
# (register, discover, book, flash deals, dashboard) works without them — each
# one degrades to a documented fallback rather than failing.
#
# Both come from the SAME Google Cloud project:
#   console.cloud.google.com → APIs & Services → Credentials → Create API key
# but they MUST be two SEPARATE keys, because they need opposite restrictions
# (details on each below).

# -----------------------------------------------------------------------------
# GOOGLE_MAPS_API_KEY — server-side transit ETA (Google Routes API)
# -----------------------------------------------------------------------------
# Used by:      api-gateway → services/etaResolver.js, googleDistanceMatrix.js
# Enable:       "Routes API" on the GCP project
# Restriction:  API restriction = Routes API only.
#               Application restriction = NONE. This key is used server-to-server
#               from inside the container, so an HTTP-referrer restriction would
#               reject every call.
# Without it:   ETAs fall back to a local haversine distance + fixed-speed
#               estimate. Booking still works; the ETA is just less accurate.
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# MAPS_JS_API_KEY — browser-side map/place picker (Maps JavaScript + Places API)
# -----------------------------------------------------------------------------
# Used by:      web-app → components/RestaurantLocationPicker.jsx, which fetches
#               this key at runtime from GET /api/v1/config/maps-key
# Enable:       "Maps JavaScript API" + "Places API" on the GCP project
# Restriction:  Application restriction = HTTP referrers, allowing
#               http://localhost:5173/*  (the web app's local origin below).
#               This key is shipped to the browser, so it MUST be referrer-locked
#               — which is exactly why it cannot be the same key as the one above.
# Without it:   /config/maps-key returns 404 and the restaurant location picker
#               falls back to manual latitude/longitude entry.
MAPS_JS_API_KEY=

# -----------------------------------------------------------------------------
# Not needed to run the stack:
#   database/scripts/enrich-places.js reads GOOGLE_MAPS_API_KEY too, but it is a
#   one-off, BILLED Google Places backfill run by hand outside Docker. It is not
#   part of `docker compose up`. See database/seeds/README.md before running it.
# -----------------------------------------------------------------------------


# =============================================================================
# 2. SECRETS
# =============================================================================
# Fine as-is for local development. Anything deployed must override JWT_SECRET
# with a real random value — the api-gateway refuses to boot under
# NODE_ENV=production without one.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d


# =============================================================================
# 3. NETWORK EXPOSURE  ← read before changing BIND_ADDR
# =============================================================================
# Which address the published ports bind to on your machine.
#
#   127.0.0.1  (default) This machine only. Nothing else on your Wi-Fi, your
#              office network, or the internet can reach the stack.
#   0.0.0.0    Every interface — anyone who can route to this machine can reach
#              the API, the database, and pgAdmin.
#
# Keep the default. This stack runs with a JWT_SECRET that is published in this
# very file, Postgres on postgres/postgres, pgAdmin on admin/admin, and
# ALLOW_LEGACY_USER_HEADER on — which means a bare `X-User-Id: <uuid>` header is
# accepted as proof of identity, and the seed UUIDs are in
# database/seeds/README.md. Anything that can reach the gateway can act as any
# user. It is a local demo, not a shareable one.
#
# The default costs you nothing for the supported workflows. A PHYSICAL PHONE on
# the tunnel reaches the API fine: the Expo dev server proxies /api/* through to
# the gateway (frontend/mobile-app/metro.config.js), so API calls ride the tunnel
# alongside the bundle and never touch a published port. The browser, Expo web at
# :8081, the iOS simulator, and the Android emulator (10.0.2.2 is an alias for
# this machine's loopback) all work too.
#
# Only LAN mode (EXPO_START_ARGS=--host lan) needs the ports opened up:
#   BIND_ADDR=0.0.0.0
# While they are, everyone on your network can act as any user in your database.
# On untrusted Wi-Fi, use the tunnel instead.
BIND_ADDR=127.0.0.1


# =============================================================================
# 4. HOST PORTS
# =============================================================================
# Change any of these if the port is already taken on your machine. Changing
# WEB_PORT also means updating the referrer restriction on MAPS_JS_API_KEY.
#
#   WEB_PORT       web app (nginx)             → http://localhost:5173
#   API_PORT       api-gateway (Node/Express)  → http://localhost:3001
#   ML_PORT        ml-service (FastAPI)        → http://localhost:8000
#   POSTGRES_PORT  postgres                    → localhost:5432
#   EXPO_PORT      Expo dev server (`mobile`)  → http://localhost:8081
#   PGADMIN_PORT   pgAdmin (`tools` profile)   → http://localhost:5050
WEB_PORT=5173
API_PORT=3001
ML_PORT=8000
POSTGRES_PORT=5432
EXPO_PORT=8081
PGADMIN_PORT=5050


# =============================================================================
# 5. DATABASE
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=table_dev

# What the seed step loads on first boot (the `migrate` service).
# Empty        → demo Manhattan restaurants + RevPASH booking fixtures only.
# --real       → also the real-data Manhattan seed: 3,000 venues
#                (006_manhattan_real_3000.sql). This is the default — it is what
#                the map, search and ML busyness lookups expect to find.
# --taxi-demand→ also ~39k historical NYC TLC taxi rows (slow, ML-only).
SEED_ARGS=--real


# =============================================================================
# 6. APP BEHAVIOUR (defaults are fine locally)
# =============================================================================
# Baked into the web bundle at BUILD time, so `docker compose up -d --build web`
# is required after changing it. The default is a same-origin relative path that
# nginx proxies to the api-gateway, which avoids CORS entirely. Point it at an
# absolute URL (e.g. http://localhost:3001/api/v1) only if you want the browser
# to call the gateway directly.
VITE_API_URL=/api/v1

# Base URL used in password-reset links (the MVP logs them to the api-gateway
# container's stdout rather than emailing them).
WEB_APP_URL=http://localhost:5173


# =============================================================================
# 7. MOBILE APP (opt-in — `docker compose --profile mobile up -d mobile`)
# =============================================================================
# The Expo dev server runs in DEVELOPMENT mode with your source bind-mounted,
# so edits hot-reload. It serves two clients on port 8081 at once:
#
#   - a browser at http://localhost:8081 — Expo web. The fastest way to click
#     through the app and visualise functionality; needs no phone, no emulator,
#     and no setup. The app already ships web variants of its native-only
#     screens (MapTab.web.tsx, WebMap.tsx, LocationComponent.web.tsx).
#
#   - Expo Go (or a dev client) on a real phone, via the QR code printed by
#     `docker compose logs -f mobile`.
#
# -----------------------------------------------------------------------------
# EXPO_START_ARGS — how the phone reaches the bundler
# -----------------------------------------------------------------------------
#   --tunnel  (default, recommended) Expo opens an ngrok tunnel and the QR code
#             carries a public https URL. Works from any network, needs no LAN
#             IP, and gets past the client isolation that university and office
#             Wi-Fi usually enforce. Slower to start and needs internet.
#
#   --host lan  Faster and works offline, but only if the phone is on the same
#             Wi-Fi as this machine AND that network allows device-to-device
#             traffic. Requires EXPO_HOST below to be your LAN IP.
#
# The QR code targets a development build by default, because the app depends on
# expo-dev-client. Append --go to target Expo Go instead (e.g. "--tunnel --go")
# if you don't have a dev build installed — but note the app's native modules
# may not all be present in Expo Go.
#
# Tunnel startup occasionally fails on the first try; the container is set to
# restart, so it retries by itself. Watch `docker compose logs -f mobile` for
# "Tunnel ready."
EXPO_START_ARGS=--tunnel

# Only used by `--host lan`. Set it to this machine's LAN IP
# (`hostname -I` on Linux, `ipconfig getifaddr en0` on macOS).
EXPO_HOST=localhost

# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL — where the app sends its API calls
# -----------------------------------------------------------------------------
# Leave this EMPTY. The Expo dev server proxies /api/* through to the gateway
# (frontend/mobile-app/metro.config.js), so the API is served from the same
# origin as the JS bundle, and the app resolves that origin at runtime. Browser,
# emulator, and a phone on the tunnel all reach the backend with no LAN IP to
# look up and nothing to configure.
#
# Only set it to pin the app at a specific gateway — a deployed staging URL, or
# a backend you're running natively outside this stack. It overrides the
# auto-detection above, which breaks the tunnel: the page is served from
# https://<host>.exp.direct but the request goes to whatever you pin here, and a
# pinned http://localhost:3001 is both cross-origin into the loopback address
# space (Chrome blocks it) and, on a real phone, the phone itself.
#
# Changing this needs `docker compose --profile mobile up -d mobile`, NOT
# `docker compose restart mobile` — restart reuses the container's existing
# environment and will silently keep the old value.
#
# NOTE: frontend/mobile-app/.env also sets EXPO_PUBLIC_API_URL (to the retired
# Cloud Run gateway). This variable wins over that file, including when empty,
# so leaving it blank here is what selects the same-origin proxy.
EXPO_PUBLIC_API_URL=

# Set to "true" only for a controlled demo: it lets a raw X-User-Id header
# stand in for a real login. Never enable it anywhere reachable from outside
# your machine.
ALLOW_LEGACY_USER_HEADER=true

# pgAdmin login (only used by: docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
